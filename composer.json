{
	"name": "automattic/jetpack-external-connections",
	"description": "Connect your site to external services.",
	"type": "jetpack-library",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.2",
		"automattic/jetpack-assets": "^4.3.38",
		"automattic/jetpack-connection": "^8.4.0",
		"automattic/jetpack-redirect": "^3.0.12",
		"automattic/jetpack-status": "^6.1.5"
	},
	"require-dev": {
		"yoast/phpunit-polyfills": "^4.0.0",
		"automattic/phpunit-select-config": "^1.0.6"
	},
	"autoload": {
		"classmap": [
			"src/"
		]
	},
	"scripts": {
		"build-development": "pnpm run build-js",
		"build-production": "pnpm run build-production-js",
		"phpunit": [
			"phpunit-select-config phpunit.#.xml.dist --colors=always"
		],
		"test-coverage": [
			"php -dpcov.directory=. ./vendor/bin/phpunit-select-config phpunit.#.xml.dist --coverage-php \"$COVERAGE_DIR/php.cov\""
		],
		"test-php": [
			"@composer phpunit"
		]
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"extra": {
		"autotagger": true,
		"branch-alias": {
			"dev-trunk": "0.1.x-dev"
		},
		"changelogger": {
			"link-template": "https://github.com/Automattic/jetpack-external-connections/compare/v${old}...v${new}"
		},
		"mirror-repo": "Automattic/jetpack-external-connections",
		"textdomain": "jetpack-external-connections",
		"version-constants": {
			"::PACKAGE_VERSION": "src/class-external-connections.php"
		}
	},
	"suggest": {
		"automattic/jetpack-autoloader": "Allow for better interoperability with other plugins that use this package."
	}
}
